# Portable dark theme for the Compliance Lab diagrams.

vars: {
  d2-config: {
    dark-theme-id: 200
    pad: 40
    sketch: false
    center: true
  }
}

classes: {
  service: {
    style: {
      fill: "#1f2335"
      stroke: "#7aa2f7"
      stroke-width: 2
      font-color: "#c0caf5"
      border-radius: 6
    }
  }

  data: {
    shape: cylinder
    style: {
      fill: "#2a2339"
      stroke: "#bb9af7"
      stroke-width: 2
      font-color: "#c0caf5"
    }
  }

  auth: {
    shape: diamond
    style: {
      fill: "#2e2030"
      stroke: "#f7768e"
      stroke-width: 2
      font-color: "#c0caf5"
    }
  }

  external: {
    style: {
      fill: "#2d2820"
      stroke: "#e0af68"
      stroke-width: 2
      font-color: "#c0caf5"
      border-radius: 6
      stroke-dash: 3
    }
  }

  llm: {
    style: {
      fill: "#2b2238"
      stroke: "#bb9af7"
      stroke-width: 2
      font-color: "#c0caf5"
      border-radius: 6
    }
  }

  agent: {
    style: {
      fill: "#1f2b2e"
      stroke: "#7dcfff"
      stroke-width: 2
      font-color: "#c0caf5"
      border-radius: 6
    }
  }

  queue: {
    shape: queue
    style: {
      fill: "#1f2733"
      stroke: "#7dcfff"
      stroke-width: 2
      font-color: "#c0caf5"
    }
  }

  user: {
    shape: person
    style: {
      fill: "#2a2a1f"
      stroke: "#e0af68"
      stroke-width: 2
      font-color: "#c0caf5"
    }
  }

  success: {
    style: {
      fill: "#1f2a1f"
      stroke: "#9ece6a"
      stroke-width: 2
      font-color: "#c0caf5"
      border-radius: 6
    }
  }

  compute: {
    style: {
      fill: "#2d2520"
      stroke: "#ff9e64"
      stroke-width: 2
      font-color: "#c0caf5"
      border-radius: 6
    }
  }

  panel: {
    style: {
      fill: "#24283b"
      stroke: "#565f89"
      stroke-width: 1
      stroke-dash: 4
      font-color: "#a9b1d6"
      border-radius: 8
    }
  }
}
